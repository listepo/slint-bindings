import { TodoItem, TodoView } from "../../todo_shared/ui/todo_view.slint";

// Re-exported: the generated Dart and the AOT glue name the row type.
export { TodoItem }

export component TodoApp inherits Window {
    preferred-width: 400px;
    preferred-height: 600px;
    title: "Slint ♥ Flutter — Todo (Skia)";

    // Host (Dart) owns the list; this default renders before the host syncs.
    in property <[TodoItem]> todo-model: [
        { title: "Wire Slint into Flutter", checked: true },
        { title: "Render this list", checked: false },
    ];

    // Named arguments carry through to the generated Dart signatures.
    callback add-todo(title: string);
    callback toggle-todo(index: int, checked: bool);
    callback remove-done();

    // The list itself is shared with the other example:
    // examples/todo_shared/ui/todo_view.slint.
    TodoView {
        todo-model: root.todo-model;
        add-todo(title) => { root.add-todo(title); }
        toggle-todo(index, checked) => { root.toggle-todo(index, checked); }
        remove-done => { root.remove-done(); }
    }
}
