<!-- WinUI 3 control library over slint_bindings_ffi.dll. Code-only skeleton:
     not compiled yet (no Windows machine in M1). -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <!-- Latest stable on nuget.org when this skeleton was written. -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
  </ItemGroup>
  <ItemGroup>
    <!-- TODO(M2): pack the per-RID DLL as runtimes/win-x64/native/slint_bindings_ffi.dll
         (built with `cargo build -p slint-bindings-ffi --target x86_64-pc-windows-msvc`). -->
    <None Include="..\..\target\x86_64-pc-windows-msvc\debug\slint_bindings_ffi.dll"
          Condition="Exists('..\..\target\x86_64-pc-windows-msvc\debug\slint_bindings_ffi.dll')"
          CopyToOutputDirectory="PreserveNewest" Link="slint_bindings_ffi.dll" />
  </ItemGroup>
</Project>
